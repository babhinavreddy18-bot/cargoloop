# 🚛 CargoLoop Master Environment Configuration Template

# -----------------------------------------------------------------------------
# Frontend Environment Variables (Prefix with VITE_)
# -----------------------------------------------------------------------------
# Gemini 2.5 Flash API Key (Get from https://aistudio.google.com/)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Project Credentials (Get from https://supabase.com)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Express Backend Server URL
VITE_API_URL=http://localhost:5000

# App Environment
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Backend Environment Variables
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Server Gemini AI Key & Supabase Credentials
GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
FRONTEND_URL=http://localhost:3000